{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Vokal — AI music director. Дизайн-токены, направление «Пульт». Тема только светлая.",
  "color": {
    "$type": "color",
    "graphite": {
      "900": { "$value": "#0d1113", "$description": "основной текст, главный CTA, пультовые поверхности" },
      "700": { "$value": "#3f4b52", "$description": "вторичный текст, 8.6:1" },
      "500": { "$value": "#5c686e", "$description": "приглушённый текст, 5.4:1" }
    },
    "steel": {
      "200": { "$value": "#dde3e6", "$description": "линии и границы" },
      "100": { "$value": "#f1f4f5", "$description": "полотно приложения" },
      "border-strong": { "$value": "#b9c3c8", "$description": "границы полей и dashed-зоны" }
    },
    "white": { "$value": "#ffffff" },
    "teal": {
      "500": { "$value": "#00d3a7", "$description": "акцент как фон; текст на нём только графитовый" },
      "700": { "$value": "#008f74", "$description": "акцент как текст на белом, 4.6:1" },
      "600-hover": { "$value": "#00bd96" },
      "tint": { "$value": "#effcf8" },
      "tint-border": { "$value": "#b9ece0" }
    },
    "amber": {
      "500": { "$value": "#c98a00" },
      "700": { "$value": "#7a5400", "$description": "6.4:1" },
      "tint": { "$value": "#fdf8ec" },
      "tint-border": { "$value": "#ecdcb5" }
    },
    "red": {
      "500": { "$value": "#ff4d4d" },
      "700": { "$value": "#a11d1d", "$description": "7.4:1" },
      "tint": { "$value": "#fdf2f2" },
      "tint-border": { "$value": "#f7cccc" }
    },
    "console": {
      "base": { "$value": "#0d1113" },
      "panel": { "$value": "#181e21" },
      "line": { "$value": "#2a3338" },
      "ink": { "$value": "#ffffff" },
      "ink-muted": { "$value": "#c3ccd0", "$description": "9.1:1 на console.base" },
      "ink-quiet": { "$value": "#8b979d" },
      "warn-ink": { "$value": "#e0a92e" },
      "danger-ink": { "$value": "#ff8080" }
    },
    "role": {
      "ink": { "$value": "{color.graphite.900}" },
      "ink-2": { "$value": "{color.graphite.700}" },
      "ink-muted": { "$value": "{color.graphite.500}" },
      "surface": { "$value": "{color.white}" },
      "canvas": { "$value": "{color.steel.100}" },
      "line": { "$value": "{color.steel.200}" },
      "accent": { "$value": "{color.teal.500}" },
      "accent-ink": { "$value": "{color.teal.700}" },
      "warn": { "$value": "{color.amber.500}" },
      "warn-ink": { "$value": "{color.amber.700}" },
      "danger": { "$value": "{color.red.500}" },
      "danger-ink": { "$value": "{color.red.700}" }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "1": { "$value": "6px", "$description": "чипы, вложенные контролы" },
    "2": { "$value": "8px", "$description": "кнопки, поля, строки" },
    "3": { "$value": "12px", "$description": "карточки, тосты" },
    "4": { "$value": "16px", "$description": "панели, модалки" },
    "pill": { "$value": "999px" }
  },
  "elevation": {
    "$type": "shadow",
    "1": { "$value": { "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0", "color": "#0d111310" } },
    "2": { "$value": { "offsetX": "0", "offsetY": "8px", "blur": "24px", "spread": "0", "color": "#0d111315" } },
    "3": { "$value": { "offsetX": "0", "offsetY": "24px", "blur": "64px", "spread": "0", "color": "#0d111324" } }
  },
  "font": {
    "$type": "fontFamily",
    "ui": { "$value": ["Manrope", "Helvetica Neue", "system-ui", "sans-serif"] },
    "data": { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] },
    "print": { "$value": ["IBM Plex Sans", "Helvetica", "Arial", "sans-serif"] }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.ui}", "fontWeight": 800, "fontSize": "clamp(2.6rem,5.6vw,4.6rem)", "lineHeight": 0.94, "letterSpacing": "-0.05em" } },
    "h2": { "$value": { "fontFamily": "{font.ui}", "fontWeight": 800, "fontSize": "36px", "lineHeight": 1.04, "letterSpacing": "-0.035em" } },
    "h3": { "$value": { "fontFamily": "{font.ui}", "fontWeight": 700, "fontSize": "22px", "lineHeight": 1.15, "letterSpacing": "-0.025em" } },
    "body": { "$value": { "fontFamily": "{font.ui}", "fontWeight": 400, "fontSize": "16px", "lineHeight": 1.6 } },
    "body-sm": { "$value": { "fontFamily": "{font.ui}", "fontWeight": 400, "fontSize": "13.5px", "lineHeight": 1.5 } },
    "label": { "$value": { "fontFamily": "{font.ui}", "fontWeight": 600, "fontSize": "12.5px", "lineHeight": 1.3 } },
    "eyebrow": { "$value": { "fontFamily": "{font.data}", "fontWeight": 600, "fontSize": "11px", "letterSpacing": "0.14em", "textTransform": "uppercase" } },
    "data": { "$value": { "fontFamily": "{font.data}", "fontWeight": 500, "fontSize": "13.5px", "fontVariantNumeric": "tabular-nums" } }
  },
  "motion": {
    "duration-fast": { "$type": "duration", "$value": "120ms" },
    "duration-base": { "$type": "duration", "$value": "160ms" },
    "duration-slow": { "$type": "duration", "$value": "240ms" },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "size": {
    "$type": "dimension",
    "control-lg": { "$value": "48px", "$description": "главный CTA, мобильная кнопка" },
    "control-md": { "$value": "44px", "$description": "кнопка, поле ввода, тач-цель" },
    "control-sm": { "$value": "38px" },
    "control-xs": { "$value": "34px", "$description": "действие в строке таблицы" },
    "icon-16": { "$value": "16px" },
    "icon-20": { "$value": "20px" },
    "icon-24": { "$value": "24px" },
    "icon-32": { "$value": "32px" },
    "content-max": { "$value": "1300px" }
  },
  "confidence": {
    "$description": "пороги уверенности транскрипции: цвет + обязательная подпись процентом",
    "high": { "$type": "number", "$value": 85 },
    "medium": { "$type": "number", "$value": 75 }
  }
}
