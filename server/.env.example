# Переменные окружения бэкенда Vokal Director.
#
# Значений здесь нет и не будет: файл лежит в git. Реальные значения — только
# в server/.env (он в .gitignore) или в переменных окружения площадки.
#
#     cp .env.example .env   и заполнить VOKAL_DATABASE_URL
#
# Необязательные переменные закомментированы намеренно: пустая строка в .env
# не то же самое, что отсутствие переменной — число или флаг из пустой строки
# не разберутся, и приложение упадет на старте.

# --- Обязательно ---------------------------------------------------------

# DSN PostgreSQL 16. Драйвер asyncpg обязателен; схему postgresql:// сервис
# сам приведет к postgresql+asyncpg://.
# Примеры без значений: postgresql+asyncpg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/ИМЯ_БАЗЫ
# Принимается и под именем DATABASE_URL — так переменную называют площадки.
VOKAL_DATABASE_URL=

# --- Приложение ----------------------------------------------------------

# local | stage | prod. По умолчанию local.
#VOKAL_APP_ENV=
# Имя сервиса в ответах /health и /ready. По умолчанию vokal-api.
#VOKAL_APP_NAME=
# DEBUG | INFO | WARNING | ERROR. По умолчанию INFO.
#VOKAL_LOG_LEVEL=
# Схема OpenAPI и /docs. true | false, по умолчанию true.
# В проде выключаем: открытая схема наружу — лишняя подсказка.
#VOKAL_DOCS_ENABLED=

# --- HTTP ----------------------------------------------------------------

# Источники для CORS через запятую. По умолчанию сервер разработки Vite
# (5173) и предпросмотр сборки (4173) на localhost и 127.0.0.1.
#VOKAL_CORS_ORIGINS=
# Заголовок с идентификатором запроса. По умолчанию X-Request-ID.
#VOKAL_REQUEST_ID_HEADER=
# Предел размера тела запроса в байтах. По умолчанию 52428800 (50 МБ) —
# столько же принимает фронтенд. Превышение дает 413, а не разрыв соединения.
#VOKAL_MAX_REQUEST_BODY_BYTES=

# --- База данных ---------------------------------------------------------

# Секунды на установку соединения. По умолчанию 5.
#VOKAL_DB_CONNECT_TIMEOUT_SECONDS=
# Секунды на проверку готовности в /ready. По умолчанию 3.
#VOKAL_DB_CHECK_TIMEOUT_SECONDS=

# --- Разработка ----------------------------------------------------------

# Хост и порт команды vokal-dev. По умолчанию 127.0.0.1 и 8000.
#VOKAL_DEV_HOST=
#VOKAL_DEV_PORT=
# Отдельная база для тестов. Без нее тест готовности с живой базой
# пропускается с пометкой, а не считается пройденным.
#VOKAL_TEST_DATABASE_URL=
