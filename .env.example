# Пример переменных окружения фронтенда Vokal Director.
# Реальные значения держим только локально: файл .env в git не попадает.
# Секретов здесь нет и быть не может: все, что начинается на VITE_, попадает
# в собранный бандл и видно любому пользователю.

# --- Источник данных ---
# Пусто — приложение работает на моках, сеть не трогается вовсе.
# Задано — работает против сервера. Адрес указывается вместе с префиксом /api.
# Локальный сервер разработки: http://127.0.0.1:8000/api
# Фронтенд и API за одним доменом: /api
VITE_API_BASE=

# Прежнее имя той же переменной. Читается как запасное, чтобы уже настроенный
# локальный .env не замолчал. В новых настройках используйте VITE_API_BASE.
VITE_API_BASE_URL=

# --- Переменные сервера ---
# Здесь их нет намеренно. Ключи провайдеров, строка подключения к базе и
# доступы к хранилищу живут только на бэкенде: см. server/.env.example.
# Все, что попадет в переменную с префиксом VITE_, окажется в бандле.
