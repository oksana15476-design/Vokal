# Пример переменных окружения Vokal Director.
# Реальные значения держим только локально: файл .env в git не попадает.
# На текущем инкременте приложение работает на моках и ни один ключ не обязателен.

# --- Будущий backend ---
# Базовый адрес API, когда моковые сервисы заменятся реальными.
VITE_API_BASE_URL=

# --- Будущие внешние провайдеры (ключи живут ТОЛЬКО на backend, не во фронтенде) ---
# Разделение на аудиослои: AudioShake или self-hosted Demucs.
AUDIOSHAKE_API_KEY=
# Транскрипция в MIDI/MusicXML/PDF, beat tracking, аккорды.
KLANGIO_API_KEY=
# LLM-адаптер AI-директора.
OPENAI_API_KEY=

# --- Хранилище и очередь ---
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
